[3150.64004, "o", "\r\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[15Pnano set_interfaces_from_yaml.py"]
[3161.103766, "o", "\r\n"]
[3161.110334, "o", "\u001b[?2004h"]
[3161.111078, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[1;58r\u001b(B\u001b[m\u001b[4l\u001b[?7h\u001b[39;49m\u001b[?1h\u001b="]
[3161.111592, "o", "\u001b[?1h\u001b="]
[3161.112026, "o", "\u001b[?25l"]
[3161.113285, "o", "\u001b[39;49m\u001b(B\u001b[m\u001b[H\u001b[2J\u001b[56;52H"]
[3161.113741, "o", "\u001b(B\u001b[0;7m[ Reading... ]"]
[3161.114146, "o", "\u001b(B\u001b[m"]
[3161.114723, "o", "\u001b[56;50H"]
[3161.115163, "o", "\u001b(B\u001b[0;7m[ Read 57 line"]
[3161.115602, "o", "s ]"]
[3161.116001, "o", "\u001b(B\u001b[m"]
[3161.117563, "o", "\u001b[H"]
[3161.117999, "o", "\u001b(B\u001b[0;7m  GNU nano 4.8                                set_interfaces_from_yaml.py                                           \u001b[1;115H"]
[3161.118399, "o", "\u001b(B\u001b[m"]
[3161.118972, "o", "\r\u001b[57d"]
[3161.119477, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G"]
[3161.119978, "o", "\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G"]
[3161.120399, "o", "\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d"]
[3161.120801, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;17H"]
[3161.12125, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File    \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[49G"]
[3161.121689, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[3161.124441, "o", "\u001b[2d"]
[3161.124905, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[3d"]
[3161.125324, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[4d"]
[3161.125743, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[5d"]
[3161.126162, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[6d"]
[3161.126615, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[8d"]
[3161.127039, "o", "logging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[3161.127469, "o", "HEADERS = {\u001b[11;5H"]
[3161.127939, "o", "\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m,\u001b[12;5H"]
[3161.128366, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\r\u001b[13d"]
[3161.128788, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[15d\b"]
[3161.129222, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m set_interface\u001b[39m\u001b(B\u001b[m(host, user, password, interface):\u001b[16;5H"]
[3161.129642, "o", "url = f\u001b(B\u001b[0;1m\u001b[32m\"http://{host}/restconf/api/running/interfaces/interface/{interface['name']}\"\u001b[17;5H"]
[3161.130106, "o", "\u001b[39m\u001b(B\u001b[mauth = HTTPBasicAuth(user, password)\u001b[19;5H"]
[3161.130512, "o", "data = {\u001b[20;9H"]
[3161.130965, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[21;13H"]
[3161.13142, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m],\u001b[22;13H"]
[3161.131864, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Configured via RESTCONF\"\u001b[39m\u001b(B\u001b[m,\u001b[23;13H"]
[3161.132285, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[24;13H"]
[3161.132726, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\u001b[25;13H"]
[3161.133178, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[26;17H"]
[3161.133594, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[27;21H"]
[3161.134038, "o", "{\u001b[28;25H"]
[3161.134451, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m],\u001b[29;25H"]
[3161.134871, "o", "\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m]\u001b[30;21H"]
[3161.135329, "o", "}\u001b[31;17H"]
[3161.13575, "o", "]\u001b[32;13H"]
[3161.136202, "o", "},\u001b[33d\b\b"]
[3161.136611, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv6\"\u001b[39m\u001b(B\u001b[m: {}\u001b[34;9H"]
[3161.137054, "o", "}\u001b[35;5H"]
[3161.13746, "o", "}\u001b[37d\b"]
[3161.137908, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Sending PUT to {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[38;5H"]
[3161.138243, "o", "response = requests.put(url, auth=auth, headers=HEADERS, data=json.dumps(data))\u001b[40;5H"]
[3161.1388, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 204:\u001b[41;9H"]
[3161.139092, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Success: {interface['name']} on {host}\"\u001b[39m\u001b(B\u001b[m)\u001b[42;5H"]
[3161.139394, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[43d\b"]
[3161.139674, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed: {interface['name']} on {host} | Code: {response.status_code} | Reason: {response.te\u001b[39m\u001b(B\u001b[0;7m>\u001b[45;1H"]
[3161.140002, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m main\u001b[39m\u001b(B\u001b[m():\u001b[46;5H"]
