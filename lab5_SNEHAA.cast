[3068.858174, "o", "}\u001b[34d\b"]
[3068.858608, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Sending PUT to {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[35;5H"]
