[3068.85283, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Configured via RESTCONF\"\u001b[39m\u001b(B\u001b[m,\u001b[20;13H"]
