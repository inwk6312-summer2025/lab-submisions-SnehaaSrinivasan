[4724.609742, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[56d"]
[4724.610183, "o", "\u001b[K\u001b[3d"]
[4724.610586, "o", "\u001b[?12l\u001b[?25h"]
[4724.6161, "o", "\u001b[?25l\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[4724.617173, "o", "\u001b[?12l\u001b[?25h"]
[4724.617611, "o", "\u001b[?25l"]
[4724.637157, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[6d"]
[4724.637811, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML data\r\u001b[7d"]
[4724.638248, "o", "\u001b[39m\u001b(B\u001b[mhosts = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'hosts.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[8d"]
[4724.638667, "o", "interfaces = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'interfaces.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[10d"]
