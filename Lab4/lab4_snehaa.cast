[3500.025384, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through each router\r\u001b[30d"]
[3500.025777, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[31;5H"]
[3500.026164, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\nConnecting to {device['ip']}...\"\u001b[39m\u001b(B\u001b[m)\u001b[32;5H"]
[3500.026562, "o", "net_connect = Netmiko(**device)\r\u001b[34d"]
[3500.026957, "o", "\u001b(B\u001b[0;1m\u001b[31m# Question 1: Parse `show ip interface brief`\u001b[35;6H"]
[3500.027356, "o", "\u001b[39m\u001b(B\u001b[moutput1 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip interface brief\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[36;6H"]
[3500.027792, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Interfaces on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[37;6H"]
[3500.028196, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m interface \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output1:\u001b[38;9H"]
[3500.028637, "o", "print(interface.get(\u001b(B\u001b[0;1m\u001b[32m'interface'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'N/A'\u001b[39m\u001b(B\u001b[m)) \u001b(B\u001b[0;1m\u001b[31m # Corrected key\u001b[40;4H"]
[3500.029033, "o", " # Question 2: Parse `show ip route` and extract protocol, network, distance, metric\u001b[41;5H"]
[3500.029453, "o", "\u001b[39m\u001b(B\u001b[moutput2 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip route\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[42;5H"]
[3500.029725, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Routes on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[43;5H"]
[3500.029986, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m route \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output2:\u001b[44;9H"]
[3500.03027, "o", "protocol = route.get(\u001b(B\u001b[0;1m\u001b[32m\"protocol\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[45;9H"]
[3500.030926, "o", "network = route.get(\u001b(B\u001b[0;1m\u001b[32m\"network\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[46;9H"]
[3500.031176, "o", "distance = route.get(\u001b(B\u001b[0;1m\u001b[32m\"distance\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[47;9H"]
[3500.031433, "o", "metric = route.get(\u001b(B\u001b[0;1m\u001b[32m\"metric\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[48;9H"]
[3500.031747, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Protocol: {protocol}, Network: {network}, Distance: {distance}, Metric: {metric}\"\u001b[39m\u001b(B\u001b[m)\u001b[50;5H"]
[3500.032007, "o", "net_connect.disconnect()\r\u001b[2d"]
