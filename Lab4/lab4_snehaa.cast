[3708.236396, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through each router\r\u001b[30d"]
[3708.23681, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[31;5H"]
[3708.237288, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\nConnecting to {device['ip']}...\"\u001b[39m\u001b(B\u001b[m)\u001b[32;5H"]
[3708.237712, "o", "net_connect = Netmiko(**device)\u001b[34;4H"]
[3708.238165, "o", "\u001b(B\u001b[0;1m\u001b[31m # Question 1: Parse `show ip interface brief`\u001b[35;5H"]
[3708.238602, "o", "\u001b[39m\u001b(B\u001b[moutput1 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip interface brief\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[36;5H"]
[3708.239044, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Interfaces on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[37;5H"]
[3708.239328, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m interface \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output1:\u001b[38;9H"]
[3708.239859, "o", "print(interface.get(\u001b(B\u001b[0;1m\u001b[32m'interface'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'N/A'\u001b[39m\u001b(B\u001b[m)) \u001b(B\u001b[0;1m\u001b[31m # Corrected key\u001b[40;4H"]
[3708.240157, "o", " # Question 2: Parse `show ip route` and extract protocol, network, distance, metric\u001b[41;5H"]
[3708.240464, "o", "\u001b[39m\u001b(B\u001b[moutput2 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip route\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[42;5H"]
[3708.240737, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Routes on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[43;5H"]
[3708.241004, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m route \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output2:\u001b[44;9H"]
[3708.241864, "o", "protocol = route.get(\u001b(B\u001b[0;1m\u001b[32m\"protocol\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[45;9H"]
[3708.242173, "o", "network = route.get(\u001b(B\u001b[0;1m\u001b[32m\"network\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[46;9H"]
[3708.242471, "o", "distance = route.get(\u001b(B\u001b[0;1m\u001b[32m\"distance\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[47;9H"]
[3708.242784, "o", "metric = route.get(\u001b(B\u001b[0;1m\u001b[32m\"metric\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[48;9H"]
[3708.243108, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Protocol: {protocol}, Network: {network}, Distance: {distance}, Metric: {metric}\"\u001b[39m\u001b(B\u001b[m)\u001b[50;5H"]
[3708.243397, "o", "net_connect.disconnect()\r\u001b[2d"]
