[4403.001004, "o", "\u001b[2d"]
[4403.0014, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[3d"]
[4403.001781, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[5d"]
[4403.002173, "o", "\u001b(B\u001b[0;1m\u001b[31m# Optional: enable logging if you want to see debug details\r\u001b[6d"]
[4403.00263, "o", "# logging.basicConfig(filename=\"netmiko_log.txt\", level=logging.DEBUG)\r\u001b[7d"]
[4403.003019, "o", "# logger = logging.getLogger(\"netmiko\")\r\u001b[9d"]
[4403.003451, "o", "# List of routers to configure\r\u001b[10d"]
[4403.003826, "o", "\u001b[39m\u001b(B\u001b[mdevices = [\u001b[11;5H"]
[4403.004234, "o", "{\u001b[12;9H"]
[4403.004651, "o", "\u001b(B\u001b[0;1m\u001b[32m\"device_type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"cisco_ios\"\u001b[39m\u001b(B\u001b[m,\u001b[13;9H"]
[4403.005039, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"192.168.1.101\"\u001b[39m\u001b(B\u001b[m,\u001b[14;9H"]
[4403.005459, "o", "\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"student\"\u001b[39m\u001b(B\u001b[m,\u001b[15;9H"]
[4403.005898, "o", "\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Meilab123\"\u001b[39m\u001b(B\u001b[m,\u001b[16;9H"]
[4403.006297, "o", "\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"22\"\u001b[39m\u001b(B\u001b[m,\u001b[17;5H"]
[4403.006734, "o", "}\r\u001b[18d"]
[4403.007121, "o", "]\u001b[20d\b"]
[4403.007532, "o", "\u001b(B\u001b[0;1m\u001b[31m# Apply config from external file\r\u001b[21d"]
[4403.007971, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[22;5H"]
[4403.008388, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n>>> Connecting to {device['ip']}\"\u001b[39m\u001b(B\u001b[m)\u001b[23;5H"]
[4403.00877, "o", "net_connect = Netmiko(**device)\u001b[25;5H"]
[4403.009203, "o", "output = net_connect.send_config_from_file(\u001b(B\u001b[0;1m\u001b[32m'changes.txt'\u001b[39m\u001b(B\u001b[m)\u001b[26;5H"]
[4403.009596, "o", "print(output)\u001b[28;5H"]
[4403.010145, "o", "net_connect.disconnect()\r\u001b[2d"]
