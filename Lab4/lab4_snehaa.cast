[3176.544195, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\nConnecting to {device['ip']}...\"\u001b[39m\u001b(B\u001b[m)\u001b[32;5H"]
[3176.544661, "o", "net_connect = Netmiko(**device)\u001b[34;4H"]
[3176.545112, "o", "\u001b(B\u001b[0;1m\u001b[31m # Question 1: Parse `show ip interface brief`\u001b[35;5H"]
[3176.545602, "o", "\u001b[39m\u001b(B\u001b[moutput1 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip interface brief\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[36;5H"]
[3176.546063, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Interfaces on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[37;5H"]
[3176.546585, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m interface \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output1:\u001b[38;9H"]
[3176.547058, "o", "print(interface[\u001b(B\u001b[0;1m\u001b[32m'intf'\u001b[39m\u001b(B\u001b[m])\u001b[40;4H"]
[3176.547513, "o", "\u001b(B\u001b[0;1m\u001b[31m # Question 2: Parse `show ip route` and extract protocol, network, distance, metric\u001b[41;5H"]
[3176.54784, "o", "\u001b[39m\u001b(B\u001b[moutput2 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip route\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[42;5H"]
[3176.548131, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Routes on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[43;5H"]
[3176.548735, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m route \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output2:\r\u001b[44d"]
