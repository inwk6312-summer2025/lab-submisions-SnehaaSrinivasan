[3527.37097, "o", "]\u001b[29d\b"]
[3527.371307, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through each router\r\u001b[30d"]
[3527.371644, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[31;5H"]
[3527.371982, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\nConnecting to {device['ip']}...\"\u001b[39m\u001b(B\u001b[m)\u001b[32;5H"]
[3527.372338, "o", "net_connect = Netmiko(**device)\r\u001b[34d"]
[3527.372682, "o", "\u001b(B\u001b[0;1m\u001b[31m# Question 1: Parse `show ip interface brief`\u001b[35;6H"]
[3527.372986, "o", "\u001b[39m\u001b(B\u001b[moutput1 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip interface brief\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[36;6H"]
[3527.373287, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Interfaces on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[37;6H"]
[3527.373672, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m interface \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output1:\u001b[38;10H"]
[3527.374092, "o", "print(interface.get(\u001b(B\u001b[0;1m\u001b[32m'interface'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'N/A'\u001b[39m\u001b(B\u001b[m)) \u001b(B\u001b[0;1m\u001b[31m # Corrected key\u001b[40;4H"]
[3527.374545, "o", " # Question 2: Parse `show ip route` and extract protocol, network, distance, metric\u001b[41;5H"]
[3527.374961, "o", "\u001b[39m\u001b(B\u001b[moutput2 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip route\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[42;5H"]
[3527.375222, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Routes on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[43;5H"]
