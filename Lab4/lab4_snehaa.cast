[3416.439758, "o", "\u001b[2d"]
[3416.440189, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[4d"]
[3416.440616, "o", "\u001b(B\u001b[0;1m\u001b[31m# List of all router devices\r\u001b[5d"]
[3416.441022, "o", "\u001b[39m\u001b(B\u001b[mdevices = [\u001b[6;5H"]
