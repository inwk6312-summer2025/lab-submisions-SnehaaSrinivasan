[4789.299524, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[4789.301414, "o", "\u001b[2d"]
[4789.301903, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[4789.302357, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[4789.302892, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[6d"]
[4789.303378, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML data\r\u001b[7d"]
[4789.303838, "o", "\u001b[39m\u001b(B\u001b[mhosts = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'hosts.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[8d"]
[4789.304323, "o", "interfaces = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'interfaces.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[10d"]
[4789.304773, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 template engine\r\u001b[11d"]
[4789.305239, "o", "\u001b[39m\u001b(B\u001b[menv = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m), trim_blocks=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, autoescape=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\r\u001b[12d"]
[4789.305712, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[14d"]
[4789.3062, "o", "\u001b(B\u001b[0;1m\u001b[31m# Render loopback configuration\r\u001b[15d"]
[4789.306885, "o", "\u001b[39m\u001b(B\u001b[mloopback_config = template.render(data=interfaces)\r\u001b[17d"]
[4789.30723, "o", "\u001b(B\u001b[0;1m\u001b[31m# Push config to each host\r\u001b[18d"]
[4789.307548, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m host \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m hosts[\u001b(B\u001b[0;1m\u001b[32m\"hosts\"\u001b[39m\u001b(B\u001b[m]:\u001b[19;5H"]
[4789.30785, "o", "net_connect = Netmiko(\u001b[20;9H"]
[4789.308146, "o", "host=host[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m],\u001b[21;9H"]
[4789.308486, "o", "username=host[\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m],\u001b[22;9H"]
[4789.309589, "o", "password=host[\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m],\u001b[23;9H"]
[4789.310117, "o", "port=host[\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m],\u001b[24;9H"]
[4789.310579, "o", "device_type=host[\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m]\u001b[25;5H"]
[4789.311027, "o", ")\u001b[26d\b"]
[4789.311513, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"✅ Logged into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\u001b[27;5H"]
[4789.311979, "o", "output = net_connect.send_config_set(loopback_config.split(\u001b(B\u001b[0;1m\u001b[32m\"\\n\"\u001b[39m\u001b(B\u001b[m))\u001b[28;5H"]
[4789.312439, "o", "print(output)\u001b[29;5H"]
[4789.312893, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"✅ Pushed loopback config into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\u001b[30;5H"]
[4789.313372, "o", "net_connect.disconnect()\r\u001b[32d"]
[4789.313815, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"✅ Done!\"\u001b[39m\u001b(B\u001b[m)\r\u001b[2d"]
