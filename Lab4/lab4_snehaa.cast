[3220.541298, "o", "]\u001b[29d\b"]
[3220.541703, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through each router\r\u001b[30d"]
[3220.542154, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[31;5H"]
[3220.542621, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\nConnecting to {device['ip']}...\"\u001b[39m\u001b(B\u001b[m)\u001b[32;5H"]
[3220.54304, "o", "net_connect = Netmiko(**device)\u001b[34;4H"]
[3220.543501, "o", "\u001b(B\u001b[0;1m\u001b[31m # Question 1: Parse `show ip interface brief`\u001b[35;5H"]
[3220.543929, "o", "\u001b[39m\u001b(B\u001b[moutput1 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip interface brief\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[36;5H"]
[3220.544358, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Interfaces on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[37;5H"]
[3220.544669, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m interface \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output1:\u001b[38;9H"]
[3220.545155, "o", "print(interface[\u001b(B\u001b[0;1m\u001b[32m'intf'\u001b[39m\u001b(B\u001b[m])\u001b[40;4H"]
[3220.545491, "o", "\u001b(B\u001b[0;1m\u001b[31m # Question 2: Parse `show ip route` and extract protocol, network, distance, metric\u001b[41;5H"]
[3220.545769, "o", "\u001b[39m\u001b(B\u001b[moutput2 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip route\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[42;5H"]
[3220.546056, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Routes on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[43;5H"]
[3220.546349, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m route \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output2:\u001b[44;9H"]
[3220.547148, "o", "protocol = route.get(\u001b(B\u001b[0;1m\u001b[32m\"protocol\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[45;9H"]
[3220.547476, "o", "network = route.get(\u001b(B\u001b[0;1m\u001b[32m\"network\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[46;9H"]
[3220.547766, "o", "distance = route.get(\u001b(B\u001b[0;1m\u001b[32m\"distance\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[47;9H"]
[3220.54806, "o", "metric = route.get(\u001b(B\u001b[0;1m\u001b[32m\"metric\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"N/A\"\u001b[39m\u001b(B\u001b[m)\u001b[48;9H"]
[3220.548386, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Protocol: {protocol}, Network: {network}, Distance: {distance}, Metric: {metric}\"\u001b[39m\u001b(B\u001b[m)\u001b[50;5H"]
