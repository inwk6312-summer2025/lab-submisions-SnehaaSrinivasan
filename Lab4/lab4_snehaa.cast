[3836.47785, "o", "]\u001b[29d\b"]
[3836.478271, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through each router\r\u001b[30d"]
[3836.47871, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[31;5H"]
[3836.479107, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n====== Device: {device['ip']} ======\\n\"\u001b[39m\u001b(B\u001b[m)\u001b[32;5H"]
[3836.479521, "o", "net_connect = Netmiko(**device)\u001b[34;4H"]
[3836.479908, "o", "\u001b(B\u001b[0;1m\u001b[31m # ✅ Question 1: Show IP Interface Brief with TextFSM\u001b[35;5H"]
[3836.48034, "o", "\u001b[39m\u001b(B\u001b[moutput1 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip interface brief\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[36;5H"]
[3836.480733, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"--- Interfaces on {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[37;5H"]
[3836.481144, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m interface \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output1:\u001b[38;9H"]
[3836.481536, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Interface: {interface.get('interface', 'N/A')}, IP: {interface.get('ip_address', 'N/A')}\"\u001b[39m\u001b(B\u001b[m)\u001b[40;4H"]
[3836.481939, "o", "\u001b(B\u001b[0;1m\u001b[31m # ✅ Question 2: View available TextFSM templates (manually done in Linux VM or GitHub folder)\u001b[41;4H"]
[3836.482358, "o", " # You can explore: /home/student/ntc-templates/templates/cisco_ios_show_ip_interface_brief.textfsm\u001b[43;4H"]
[3836.482792, "o", " # ✅ Question 3: Parse \"show ip route\" and extract protocol, network, distance, metric\u001b[44;5H"]
[3836.483206, "o", "\u001b[39m\u001b(B\u001b[moutput2 = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip route\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[45;5H"]
[3836.483633, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- IP Routing Table for {device['ip']} ---\"\u001b[39m\u001b(B\u001b[m)\u001b[46;5H"]
