[3416.448426, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"192.168.1.103\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[31m # R3\u001b[23;9H"]
